# Copy to config/local.env and change secrets before deploying.

IMAGEGEN_ADDR=127.0.0.1:8092
IMAGEGEN_DATABASE_DSN=
IMAGEGEN_DB=data/imagegen.sqlite
IMAGEGEN_PUBLIC_BASE_URL=http://127.0.0.1:8092
IMAGEGEN_WEB_BASE_URL=http://127.0.0.1:4102
IMAGEGEN_CORS_ORIGINS=http://127.0.0.1:4102,http://localhost:4102
# Use .qiayan.ai in production if API and web are sibling subdomains.
IMAGEGEN_SESSION_COOKIE_DOMAIN=
IMAGEGEN_ADMIN_TOKEN=change-me-admin-token
IMAGEGEN_SESSION_SECRET=change-me-session-secret
IMAGEGEN_SECRET_KEY=change-me-32-byte-or-longer-secret-key
IMAGEGEN_LOG_FILE=

IMAGEGEN_STORAGE_DIR=data/storage
IMAGEGEN_STORAGE_PROVIDER=r2
IMAGEGEN_ENGINE_HOME_DIR=data/engines
IMAGEGEN_WORKDIR=.
IMAGEGEN_RUNNER_PATH=/usr/local/bin/imagen-runner
IMAGEGEN_RUNNER_MODEL=
IMAGEGEN_WORKERS=2
IMAGEGEN_TASK_TIMEOUT_SECONDS=900
IMAGEGEN_MAX_IMAGES_PER_TASK=10

# New API keys created without an explicit total limit get this quota.
IMAGEGEN_DEFAULT_KEY_IMAGE_CAP=100

# Default provider account created on first boot.
IMAGEGEN_DEFAULT_ACCOUNT_CONCURRENCY=1

# Cloudflare R2 / S3-compatible storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://img.example.com
R2_KEY_PREFIX=imagegen/

# Google OAuth admin login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8092/admin/auth/google/callback
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_ALLOWED_DOMAINS=
