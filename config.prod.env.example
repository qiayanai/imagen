# Copy to the production config path with deploy/prod.sh init-config.
# Fill every secret before deploying.

IMAGEGEN_ADDR=0.0.0.0:8092
IMAGEGEN_DATABASE_DSN=postgres://imagen:replace-with-postgres-password@kageos-hub-postgres:5432/imagen?sslmode=disable
IMAGEGEN_PUBLIC_BASE_URL=https://imagen-api.example.com
IMAGEGEN_WEB_BASE_URL=https://imagen.example.com
IMAGEGEN_CORS_ORIGINS=https://imagen.example.com
IMAGEGEN_SESSION_COOKIE_DOMAIN=.example.com
IMAGEGEN_ADMIN_TOKEN=replace-with-random-admin-token
IMAGEGEN_SESSION_SECRET=replace-with-random-session-secret
IMAGEGEN_SECRET_KEY=replace-with-32-byte-or-longer-secret-key
IMAGEGEN_LOG_FILE=/var/log/imagen/imagen-api.log

IMAGEGEN_STORAGE_DIR=/var/lib/imagen/storage
IMAGEGEN_STORAGE_PROVIDER=r2
IMAGEGEN_ENGINE_HOME_DIR=/var/lib/imagen/engines
IMAGEGEN_WORKDIR=/var/lib/imagen/work
IMAGEGEN_RUNNER_PATH=/app/bin/imagen-runner
IMAGEGEN_RUNNER_MODEL=
IMAGEGEN_WORKERS=2
IMAGEGEN_TASK_TIMEOUT_SECONDS=900
IMAGEGEN_MAX_IMAGES_PER_TASK=10
IMAGEGEN_DEFAULT_KEY_IMAGE_CAP=100
IMAGEGEN_DEFAULT_ACCOUNT_CONCURRENCY=1

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://cdn.example.com
R2_KEY_PREFIX=imagegen/

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://imagen-api.example.com/admin/auth/google/callback
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_ALLOWED_DOMAINS=
